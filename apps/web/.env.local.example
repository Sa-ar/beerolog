# Base URL of the API — no trailing slash
# Local dev: http://localhost:8000
# Production: https://your-api.up.railway.app
# This origin must be included in the API CORS_ALLOWED_ORIGINS setting.
VITE_API_URL=http://localhost:8000

# Clerk development instance publishable key (Dashboard → API Keys)
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk secret key for TanStack Start server middleware (Dashboard → API Keys)
# Never expose this in client code.
CLERK_SECRET_KEY=

# Vercel Blob read-write token (Dashboard → Storage → Blob → Tokens)
# Used by packages/db catalog scripts to host beer label images.
BLOB_READ_WRITE_TOKEN=

# PostHog analytics. The project token is client-exposed (safe in the bundle).
# EU project → host is https://eu.i.posthog.com. Leave the token blank to disable
# analytics locally (initAnalytics() no-ops).
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# PostHog CLI — source-map upload during the production build (postbuild step).
# Personal API key (write) + project id. Set ONLY in the Vercel Production env,
# never locally. Unset → the upload step is skipped and the build still succeeds.
POSTHOG_CLI_TOKEN=
POSTHOG_CLI_ENV_ID=
