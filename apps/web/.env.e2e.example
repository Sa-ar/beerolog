# Copy to .env.e2e (gitignored) and fill in. Used by Playwright (playwright.config.ts).
E2E_BASE_URL=http://localhost:5173
E2E_CLERK_EMAIL=your-dev-clerk-test-user@example.com
E2E_CLERK_PASSWORD=your-dev-clerk-test-password
# Only needed for SSO-protected Vercel preview URLs:
# Vercel → Settings → Deployment Protection → Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=
