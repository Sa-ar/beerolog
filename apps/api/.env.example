# Runtime environment for the supported API surface: development, preview, or production
APP_ENV=development

# Neon PostgreSQL connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Per-worktree DB (scripts/db.sh). Default 'local' = an isolated docker pgvector
# Postgres, no cloud secrets. Set 'neon' for Neon branch-per-worktree instead,
# which then needs a PROJECT-SCOPED NEON_API_KEY + NEON_PROJECT_ID below.
DB_MODE=local
NEON_API_KEY=
NEON_PROJECT_ID=

# OpenAI secret key — used for recommendation explanations on the supported MVP path
OPENAI_API_KEY=

# Clerk — from Clerk Dashboard → API Keys
# Publishable key (pk_test_... for dev, pk_live_... for prod) derives the JWKS URL for token verification
CLERK_PUBLISHABLE_KEY=
# Secret key (sk_test_... for dev, sk_live_... for prod)
CLERK_SECRET_KEY=

# Comma-separated origins allowed to call the API from browsers
# Local dev default matches the web app dev server
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Python log level for API request logs and startup warnings
LOG_LEVEL=INFO

# HS256 secret used by deferred QR and challenge token flows
# IMPORTANT: override this in production if you later enable those surfaces
API_SECRET=dev-secret

# Taste-profile matcher knobs (PRD: docs/prds/taste-profile-matcher.md)
# alpha: weight on BaselineTaste vs SessionIntent (0..1, baseline-weight)
MATCH_ALPHA=0.6
# Baseline weight when session intent is present (lower → session matters more)
MATCH_SESSION_ALPHA=0.4
# beta: weight on the novelty re-rank (NoveltyAffinity × adventurousness)
MATCH_BETA=0.3
# Bonus/penalty when beer ABV matches/mismatches session abv_intent
MATCH_ABV_WEIGHT=0.15
# Affine rescale anchors for user-facing match % (probe: tests/eval/probe_cosine_calibration)
MATCH_COS_FLOOR=0.20
MATCH_COS_CEILING=0.50
# Days after which a persisted BaselineTaste embedding is re-computed
BASELINE_STALENESS_DAYS=7
# Embedding model used for BaselineTaste, SessionIntent, and BeerEmbedding
EMBEDDING_MODEL=text-embedding-3-large

# Vercel Blob read-write token — catalog image upload (packages/db upload:catalog-images)
BLOB_READ_WRITE_TOKEN=
