# Neon PostgreSQL connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# OpenAI secret key — used for embeddings (text-embedding-3-small) and menu scanning / explanations (gpt-4o)
OPENAI_API_KEY=

# AWS Cognito — from the user pool and app client dashboards
# Format: us-east-1_XXXXXXXXX
COGNITO_USER_POOL_ID=
# App client ID (not the secret)
COGNITO_CLIENT_ID=
# Region where the user pool was created (default: us-east-1)
COGNITO_REGION=us-east-1

# HS256 secret used to sign QR tokens and friend-challenge tokens
# IMPORTANT: override this in production — the default is NOT secure
API_SECRET=dev-secret
