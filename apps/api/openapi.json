        "title": "ReadinessResponse",
        "type": "object"
      },
      "RecommendationsRequest": {
        "description": "Debug-style request: caller supplies the dials + intent directly.\n\nSlice #76 introduces persisted BaselineTaste; this slice posts the\nanswers inline to keep the smoke test independent of user persistence.",
        "properties": {
          "alpha": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alpha"
          },
          "baseline": {
            "$ref": "#/components/schemas/BaselineTasteDials"
          },
          "beta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Beta"
          },
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionIntent"
              },
              {
                "type": "null"
              }
            ]
          },
          "top_k": {
            "default": 5,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "baseline"
        ],
        "title": "RecommendationsRequest",
        "type": "object"
      },
      "RecommendationsResponse": {
        "properties": {
          "alpha": {
            "title": "Alpha",
            "type": "number"
          },
          "beta": {
            "title": "Beta",
            "type": "number"
          },
          "calibration": {
            "$ref": "#/components/schemas/MatchCalibration"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RecommendedBeer"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results",
          "alpha",
          "beta",
          "calibration"
        ],
        "title": "RecommendationsResponse",
        "type": "object"
      },
      "RecommendedBeer": {
        "properties": {
          "abv": {
            "title": "Abv",
            "type": "number"
          },
          "breakdown": {
            "$ref": "#/components/schemas/ScoreBreakdown"
          },
