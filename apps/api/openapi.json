        "type": "string"
      },
      "TasteProfileIcon": {
        "properties": {
          "flavor_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flavor Key"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "svg": {
            "title": "Svg",
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "svg"
        ],
        "title": "TasteProfileIcon",
        "type": "object"
      },
