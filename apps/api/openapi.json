          },
          "session_score": {
            "title": "Session Score",
            "type": "number"
          },
          "total_score": {
            "title": "Total Score",
            "type": "number"
          }
        },
        "required": [
          "baseline_cos",
          "session_cos",
          "baseline_score",
          "session_score",
          "abv_score",
          "novelty_score",
          "total_score",
          "dominant_component"
