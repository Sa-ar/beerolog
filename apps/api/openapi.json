    "schemas": {
      "AbvIntent": {
        "enum": [
          "low",
          "medium",
          "high",
          "any"
        ],
        "title": "AbvIntent",
        "type": "string"
      },
      "BaselineTasteDials": {
        "description": "User-facing, editable taste dials derived from onboarding answers.",
        "properties": {
          "bitterness": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Bitterness",
            "type": "number"
          },
          "bubbles": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Bubbles",
            "type": "number"
          },
          "flavor_family": {
            "additionalProperties": {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            "title": "Flavor Family",
            "type": "object"
          },
          "novelty_affinity": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Novelty Affinity",
            "type": "number"
          }
        },
        "required": [
          "bubbles",
          "bitterness",
          "flavor_family",
          "novelty_affinity"
        ],
        "title": "BaselineTasteDials",
        "type": "object"
      },
      "BaselineTasteRecord": {
        "description": "Persisted BaselineTaste returned by /me/baseline-taste.",
        "properties": {
          "bitterness": {
            "title": "Bitterness",
            "type": "number"
          },
          "bubbles": {
            "title": "Bubbles",
            "type": "number"
          },
          "embedding_fresh_at": {
            "title": "Embedding Fresh At",
            "type": "string"
          },
          "flavor_family": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Flavor Family",
            "type": "object"
          },
          "icons": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TasteProfileIcons"
              },
              {
                "type": "null"
              }
            ]
          },
          "novelty_affinity": {
            "title": "Novelty Affinity",
            "type": "number"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "bubbles",
          "bitterness",
          "flavor_family",
          "novelty_affinity",
          "embedding_fresh_at",
          "updated_at"
        ],
        "title": "BaselineTasteRecord",
        "type": "object"
      },
      "Carbonation": {
        "enum": [
          "still",
          "light",
          "strong"
        ],
