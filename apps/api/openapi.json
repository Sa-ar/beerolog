        "type": "object"
      },
      "PatchBaselineTasteRequest": {
        "properties": {
          "bitterness": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bitterness"
          },
          "bubbles": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bubbles"
          },
          "flavor_family": {
            "anyOf": [
              {
                "additionalProperties": {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flavor Family"
          },
          "novelty_affinity": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Novelty Affinity"
          }
        },
        "title": "PatchBaselineTasteRequest",
        "type": "object"
      },
      "RatingRecord": {
        "properties": {
          "beer_brewery": {
            "title": "Beer Brewery",
            "type": "string"
          },
          "beer_id": {
            "title": "Beer Id",
            "type": "string"
          },
          "beer_name": {
            "title": "Beer Name",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
