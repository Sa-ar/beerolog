          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "ratings": {
            "items": {
              "$ref": "#/components/schemas/RatingRecord"
            },
            "title": "Ratings",
            "type": "array"
          }
        },
        "required": [
          "ratings",
          "page",
          "page_size"
        ],
        "title": "RatingsHistoryResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "components": {
            "items": {
