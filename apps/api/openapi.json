            "$ref": "#/components/schemas/LovePref"
          },
          "snack": {
            "$ref": "#/components/schemas/SnackPick"
          },
          "sour_foods": {
            "$ref": "#/components/schemas/LovePref"
          },
          "water": {
            "$ref": "#/components/schemas/Carbonation"
          }
        },
        "required": [
          "coffee",
          "water",
          "novelty_seeking",
          "snack",
          "sour_foods",
          "citrus",
          "smoked_foods"
        ],
