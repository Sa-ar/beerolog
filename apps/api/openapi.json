        "type": "string"
      },
      "WhyLine": {
        "description": "Language-neutral recommendation explanation.\n\nThe API picks the code + params; the frontend renders the localized\nsentence (key why.<code>). Keeps copy in one place and the embedding\ntemplates English-only.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "code"
        ],
        "title": "WhyLine",
        "type": "object"
      }
