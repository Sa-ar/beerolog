            "type": "string"
          }
        },
        "required": [
          "key",
          "purpose",
          "svg"
        ],
        "title": "CatalogIconItem",
        "type": "object"
      },
      "CitrusPick": {
        "enum": [
          "grapefruit",
          "orange",
          "lemonade",
          "none"
