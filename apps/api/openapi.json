        },
        "required": [
          "id",
          "name",
          "brewery",
          "style",
          "abv",
          "market_tier",
          "color",
          "why",
          "breakdown"
        ],
        "title": "RecommendedBeer",
        "type": "object"
      },
      "ScoreBreakdown": {
