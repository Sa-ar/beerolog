    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Beerolog API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/debug/recommendations": {
      "get": {
        "operationId": "debugRecommendations",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Debug Recommendations",
        "tags": [
          "debug"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness"
      }
    },
    "/icons/catalog": {
      "get": {
        "operationId": "getIconCatalog",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IconCatalogResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Icon Catalog",
        "tags": [
          "icons"
        ]
      }
    },
    "/me/baseline-taste": {
      "get": {
        "operationId": "getMyBaselineTaste",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaselineTasteRecord"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get My Baseline Taste",
        "tags": [
          "onboarding"
        ]
      },
      "patch": {
        "operationId": "patchMyBaselineTaste",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchBaselineTasteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaselineTasteRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Patch My Baseline Taste",
        "tags": [
          "onboarding"
        ]
      }
    },
    "/me/ratings": {
      "get": {
        "operationId": "listMyRatings",
        "parameters": [
