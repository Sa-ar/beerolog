{
  "name": "beerolog",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "pnpm lint:js && pnpm lint:api",
    "typecheck": "turbo typecheck",
    "test": "pnpm test:api",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "lint:js": "turbo lint",
    "lint:api": "uv --directory apps/api run ruff check . && uv --directory apps/api run ruff format --check .",
    "test:api": "uv --directory apps/api run pytest tests/ -v"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.4"
  },
  "packageManager": "pnpm@11.3.0"
}
