{
  "name": "@beerolog/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "ingest:catalog": "tsx scripts/seed_catalog/ingest_catalog.ts",
    "merge:catalog": "python3 scripts/seed_catalog/merge_catalog_sources.py",
    "validate:catalog": "python3 scripts/seed_catalog/validate_catalog.py",
    "upload:catalog-images": "tsx scripts/seed_catalog/upload_images_to_blob.ts"
  },
  "dependencies": {
    "@beerolog/types": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@vercel/blob": "^0.27.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
